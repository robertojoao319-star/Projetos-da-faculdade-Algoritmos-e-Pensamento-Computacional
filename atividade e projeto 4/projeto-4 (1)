int bubbleSort(int v[], int n) {

    int i, j;
    int auxiliar;
    int comparacoes = 0;

    for (i = 0; i < n - 1; i++) {

        for (j = 0; j < n - 1 - i; j++) {

            comparacoes++;

            if (v[j] > v[j + 1]) {

                auxiliar = v[j];
                v[j] = v[j + 1];
                v[j + 1] = auxiliar;
            }
        }
    }

    return comparacoes;
}


int selectionSort(int v[], int n) {

    int i, j;
    int menor;
    int auxiliar;
    int comparacoes = 0;

    for (i = 0; i < n - 1; i++) {

        menor = i;

        for (j = i + 1; j < n; j++) {

            comparacoes++;

            if (v[j] < v[menor]) {

                menor = j;
            }
        }

        if (menor != i) {

            auxiliar = v[i];
            v[i] = v[menor];
            v[menor] = auxiliar;
        }
    }

    return comparacoes;
}


int insertionSort(int v[], int n) {

    int i, j;
    int chave;
    int comparacoes = 0;

    for (i = 1; i < n; i++) {

        chave = v[i];
        j = i - 1;

        while (j >= 0) {

            comparacoes++;

            if (v[j] > chave) {

                v[j + 1] = v[j];
                j--;

            } else {

                break;
            }
        }

        v[j + 1] = chave;
    }

    return comparacoes;
}


int vetoresIguais(int a[], int b[], int n) {

    int i;

    for (i = 0; i < n; i++) {

        if (a[i] != b[i]) {

            return 0;
        }
    }

    return 1;
}
